# Required: OpenAI API key (covers Whisper STT + GPT-4o LLM + TTS)
OPENAI_API_KEY=sk-...your-key-here...

# Optional: Use a specific OpenAI model (default: gpt-4o)
LLM_MODEL=gpt-4o

# Optional: Override TTS voice (alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=alloy

# Optional: ElevenLabs (if you prefer higher-quality TTS)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# Server port (default: 3001)
PORT=3001
